<launch>
  <arg name="stage" default="5"/>
  <param name="stage_number"  value="$(arg stage)"/>
  <node pkg="turtlebot3_sac" type="validate_4.py" name="turtlebot3_sac_stage_1" output="screen" />
  <node pkg="turtlebot3_sac" type="combination_obstacle_3.py" name="combination_obstacle_3" output="screen" />
  <node pkg="turtlebot3_sac" type="combination_obstacle_4.py" name="combination_obstacle_4" output="screen" />
</launch>