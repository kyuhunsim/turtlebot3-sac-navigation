<launch>
  <arg name="stage" default="4"/>
  <param name="stage_number"  value="$(arg stage)"/>
  <node pkg="turtlebot3_sac" type="train_2.py" name="turtlebot3_sac_stage_4" output="screen" />

  <node pkg="turtlebot3_sac" type="combination_obstacle_1.py" name="combination_obstacle_1" output="screen" />
  <node pkg="turtlebot3_sac" type="combination_obstacle_2.py" name="combination_obstacle_2" output="screen" />
</launch>
